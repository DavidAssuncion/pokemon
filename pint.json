{
    "preset": "psr12",
    "rules": {
        "declare_strict_types": true,
        "strict_param": true,
        "no_unused_imports": true,
        "ordered_imports": { "sort_algorithm": "alpha" },
        "single_quote": true,
        "trailing_comma_in_multiline": true,
        "return_type_declaration": { "space_before": "none" },
        "no_empty_phpdoc": true,
        "phpdoc_no_access": true,
        "phpdoc_scalar": true,
        "phpdoc_summary": true,
        "phpdoc_trim": true
    }
}
