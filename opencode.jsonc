{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "analista",
  "agent": {
    "analista": {
      "description": "Analista: transforma ideas en especificación. No codea.",
      "mode": "primary",
      "prompt": "{file:./docs/agents/analista.md}",
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "backend": {
      "description": "Backend Laravel: implementa con TDD. Análisis previo obligatorio.",
      "mode": "subagent",
      "prompt": "{file:./docs/agents/backend.md}"
    },
    "frontend": {
      "description": "Frontend Blade: implementa UI. Análisis previo obligatorio.",
      "mode": "subagent",
      "prompt": "{file:./docs/agents/frontend.md}"
    },
    "qa": {
      "description": "QA: valida edge cases, E2E, handoff consistency. Bloquea si falla.",
      "mode": "subagent",
      "prompt": "{file:./docs/agents/qa.md}",
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "cleaner": {
      "description": "Cleaner: refactoriza (CRAP/DRY, mutation sites, encapsulamiento). No features.",
      "mode": "subagent",
      "prompt": "{file:./docs/agents/cleaner.md}"
    },
    "arquitecto": {
      "description": "Arquitecto: code review POST-implementación. Valida estructura, boundaries, property tests.",
      "mode": "subagent",
      "prompt": "{file:./docs/agents/arquitecto.md}",
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "hardener": {
      "description": "Hardener: mutation hardening, language mutation, soft Gherkin. Última barrera.",
      "mode": "subagent",
      "prompt": "{file:./docs/agents/hardener.md}",
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "bibliotecario": {
      "description": "Bibliotecario: documenta conocimiento, cierra tarea. No codea.",
      "mode": "subagent",
      "prompt": "{file:./docs/agents/bibliotecario.md}",
      "permission": { "bash": "deny" }
    }
  }
}