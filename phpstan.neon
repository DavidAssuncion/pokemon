includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - phpstan-baseline.php

parameters:
    paths:
        - src/
        - app/

    level: 6

    excludePaths:
        analyse:
            - vendor/
            - bootstrap/cache/
            - storage/
            - public/
            - resources/
            - database/
            - config/
            - routes/
            - tests/

    ignoreErrors:
        -
            message: '#^Dynamic call to static method Illuminate\\Database\\Eloquent\\Builder<App\\Models\\(Nido|Refugio|Complemento|PlayerInventory)>::lockForUpdate\(\)\.$#'
            identifier: staticMethod.dynamicCall
            paths:
                - src/Granjas/App/*
